# 站点对外地址（写死会影响 canonical / sitemap / og:url）
NEXT_PUBLIC_SITE_URL=https://mobile.91xungou.com

# PHP API 地址（服务端抓取，不出现在前端代码里）
API_BASE=https://api.91xungou.com

# 详情数据缓存秒数（同时是页面 ISR 周期）
API_REVALIDATE=300

# 图片 CDN
NEXT_PUBLIC_IMG_BASE=https://img.91xungou.com

# 小程序码本地缓存目录（默认 <cwd>/.cache/qr）
QR_CACHE_DIR=

# ICP 备案号，留空则不渲染
NEXT_PUBLIC_ICP_BEIAN=
